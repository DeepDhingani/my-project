<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2"><br>
            <h3>Listing Details</h3>

            <img src="<%= listing.image %>" alt="<%= listing.title %>" class="img-fluid rounded-4 mb-2" style="width: 100%; max-height: 400px; object-fit: cover;">

            <p class="mb-0"><b><%= listing.title %></b></p>
            <p class="mb-0">
                <%= listing.description %>
            </p>
            <p class="mb-0">&#8377;
                <%= listing.price.toLocaleString("en-IN") %>
            </p>
            <p class="mb-0">
                <%= listing.location %>
            </p>
            <p class="mb-0">
                <%= listing.country %>
            </p>

            <div class="d-flex gap-3 mt-4 mb-4">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger">Edit</a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
        </div>
    </div>