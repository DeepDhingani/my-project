<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-12 col-md-8 offset-md-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <!-- Listing card -->
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card shadow-sm border-0">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="<%= listing.title %>" style="height: 24rem; object-fit: cover;">

                <div class="card-body">
                    <p class="card-text mb-1">
                        Owned by <i><%= listing.owner ? listing.owner.username : "Unknown" %></i>
                    </p>
                    <p class="card-text mb-1">
                        <%= listing.description %>
                    </p>
                    <p class="card-text mb-1">&#8377;
                        <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
                    </p>
                    <p class="card-text mb-1">
                        <%= listing.location %>
                    </p>
                    <p class="card-text mb-0">
                        <%= listing.country %>
                    </p>
                </div>
            </div>

            <!-- Owner-only actions -->
            <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
                <div class="d-flex gap-2 mt-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-outline-danger">Delete</button>
                    </form>
                </div>
                <% } %>
        </div>

        <!-- Review form -->
        <div class="col-12 col-md-8 offset-md-2 mt-4">
            <hr>
            <% if (currentUser) { %>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3">Leave a Review</h4>

                        <form method="post" action="/listings/<%= listing._id %>/reviews" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <input type="range" class="form-range" id="rating" name="review[rating]" min="1" max="5" step="1" value="3" required>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea class="form-control" id="comment" name="review[comment]" rows="4" placeholder="Share your experience" required></textarea>
                                <div class="invalid-feedback">Please add a comment.</div>
                            </div>

                            <button type="submit" class="btn btn-dark">Submit Review</button>
                        </form>
                    </div>
                </div>
                <% } else { %>
                    <p class="text-muted"><a href="/login">Log in</a> to leave a review.</p>
                    <% } %>
        </div>

        <!-- All reviews -->
        <div class="col-12 col-md-8 offset-md-2 mt-4 mb-5">
            <hr>
            <h4 class="mb-3">All Reviews</h4>

            <% if (listing.reviews.length === 0) { %>
                <div class="alert alert-light border text-center">No reviews yet. Be the first to share your experience!</div>
                <% } else { %>
                    <% const avg = listing.reviews.reduce((sum, r) => sum + r.rating, 0) / listing.reviews.length; %>
                        <p class="text-muted">
                            <strong><%= avg.toFixed(1) %></strong> / 5 from
                            <%= listing.reviews.length %> review(s)
                        </p>

                        <div class="row g-3">
                            <% for (let review of listing.reviews) { %>
                                <div class="col-12 col-md-6">
                                    <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger">
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-subtitle mb-2 text-muted">
                                                @
                                                <%= review.author ? review.author.username : "deleted user" %>
                                            </h6>

                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="text-warning fs-5">
                                        <%= "★".repeat(review.rating) %><span class="text-secondary opacity-50"><%= "★".repeat(5 - review.rating) %></span>
                                                </span>
                                                <span class="badge bg-dark"><%= review.rating %>/5</span>
                                            </div>

                                            <p class="card-text flex-grow-1">
                                                <%= review.comment %>
                                            </p>
                                        </div>

                                        <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                    <%= review.createdAt ? review.createdAt.toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) : "" %>
                                </small>

                                            <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                                <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <% } %>
        </div>
    </div>