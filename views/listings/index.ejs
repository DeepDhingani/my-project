<% layout("/layouts/boilerplate") %>

    <% const filters = [
    { key: "trending",      label: "Trending",      icon: "fa-fire" },
    { key: "rooms",         label: "Rooms",         icon: "fa-bed" },
    { key: "iconic-cities", label: "Iconic Cities", icon: "fa-mountain-city" },
    { key: "mountains",     label: "Mountains",     icon: "fa-mountain" },
    { key: "castles",       label: "Castles",       icon: "fa-chess-rook" },
    { key: "amazing-pools", label: "Amazing Pools", icon: "fa-person-swimming" },
    { key: "camping",       label: "Camping",       icon: "fa-campground" },
    { key: "farms",         label: "Farms",         icon: "fa-cow" },
    { key: "arctic",        label: "Arctic",        icon: "fa-snowflake" },
]; %>

        <!-- Filters + tax toggle -->
        <div id="filters-bar">
            <div id="filters">
                <% for (let f of filters) { %>
                    <a href="/listings?category=<%= f.key %>" class="filter <%= activeCategory === f.key ? 'active' : '' %>">
                        <div><i class="fa-solid <%= f.icon %>"></i></div>
                        <p>
                            <%= f.label %>
                        </p>
                    </a>
                    <% } %>
            </div>

            <div class="tax-toggle">
                <div class="form-check form-switch form-check-reverse">
                    <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
                    <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
                </div>
            </div>
        </div>

        <h3 class="mt-3 mb-3">
            <%= activeCategory ? filters.find((f) => f.key === activeCategory).label : "All listings" %>
        </h3>

        <!-- Listings grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (let listing of allListings) { %>
                <div class="col">
                    <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                        <div class="card h-100 border-0 listing-card">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 20rem; object-fit: cover;">
                            <div class="card-body px-1">
                                <h5 class="card-title mb-1"><b><%= listing.title %></b></h5>
                                <p class="card-text">
                                    <span class="price" data-price="<%= listing.price || 0 %>">
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
    </span> / night
                                    <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
                <% } %>
        </div>