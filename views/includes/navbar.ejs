<nav class="navbar navbar-expand-md sticky-top app-navbar">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand brand" href="/listings">
            <i class="fa-solid fa-compass"></i>
            <span class="d-none d-lg-inline ms-2">wanderlust</span>
        </a>

        <!-- Search: outside the collapse, so it is always visible -->
        <form class="search-form nav-search" role="search" action="/listings" method="get">
            <input class="search-input" type="search" name="search" placeholder="Search destinations" aria-label="Search destinations" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button class="search-btn" type="submit" aria-label="Search">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </form>

        <!-- Hamburger (phones only) -->
        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Links: these are the only items inside the hamburger menu -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav ms-auto align-items-md-center">
                <a class="nav-link" href="/listings">All Listings</a>
                <a class="nav-link" href="/listings/new">Add new Listing</a>

                <% if (!currentUser) { %>
                    <a class="nav-link" href="/login">Log in</a>
                    <a class="btn btn-brand ms-md-2 my-2 my-md-0" href="/signup">Sign up</a>
                    <% } else { %>
                        <span class="navbar-text text-dark mx-md-2">
                        <i class="fa-solid fa-user" style="color: var(--brand);"></i> <%= currentUser.username %>
                    </span>
                        <a class="nav-link" href="/logout">Log out</a>
                        <% } %>
            </div>
        </div>
    </div>
</nav>